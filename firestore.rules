rules_version = '2';
service cloud.firestore {
  match /databases/eventos-divergentes/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // Lee el rol del usuario autenticado desde su perfil en Firestore.
    // El get() se cachea por request, no genera lecturas extra en cascada.
    function getUserRole() {
      let ref = /databases/$(database)/documents/eventoUsuarios/$(request.auth.uid);
      return isAuth() && exists(ref) ? get(ref).data.role : '';
    }

    // Cualquier miembro del equipo (admin, staff)
    function isStaff() {
      return isAuth() && getUserRole() in ['admin', 'admin_empresa', 'staff', 'superadmin'];
    }

    // Administrador de empresa o superior
    function isAdmin() {
      return isAuth() && getUserRole() in ['admin', 'admin_empresa', 'superadmin'];
    }

    // Solo superadmin
    function isSuperAdmin() {
      return isAuth() && getUserRole() == 'superadmin';
    }

    // clienteId del perfil del usuario autenticado (para acotar lecturas por tenant)
    function getUserClienteId() {
      let ref = /databases/$(database)/documents/eventoUsuarios/$(request.auth.uid);
      return isAuth() && exists(ref) ? get(ref).data.clienteId : '';
    }

    // ── Asistentes ───────────────────────────────────────────────────────────
    // Lectura pública necesaria para el autocompletado de cédula en el registro.
    match /eventoAsistentes/{doc} {
      allow read: if true;
      // Registro público y registro desde admin: validar campos mínimos
      allow create: if
        request.resource.data.keys().hasAll(['fullName', 'documentId', 'eventoId', 'clienteId']) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.documentId is string &&
        request.resource.data.documentId.size() > 0 &&
        request.resource.data.eventoId is string &&
        request.resource.data.clienteId is string;
      allow update: if isStaff();   // check-in, edición de datos
      allow delete: if isAdmin();
    }

    // ── Estaciones (lectura pública — mapa y kiosk sin login) ───────────────
    match /eventoEstaciones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Eventos (lectura pública — info básica para páginas públicas) ────────
    match /eventoEventos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Visitas (escritura y lectura públicas — kiosk y MiEventoPage) ────────
    match /eventoVisitas/{doc} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['eventoId', 'estacionId', 'visitanteId']) &&
        request.resource.data.eventoId is string &&
        request.resource.data.estacionId is string &&
        request.resource.data.visitanteId is string &&
        request.resource.data.calificacion is number &&
        request.resource.data.calificacion >= 0 &&
        request.resource.data.calificacion <= 5;
      allow update, delete: if isAdmin();
    }

    // ── Calificaciones (escritura pública validada — solo admin lee) ─────────
    match /eventoCalificaciones/{doc} {
      allow read: if isStaff();
      allow create: if
        request.resource.data.keys().hasAll(['stars', 'eventoId']) &&
        request.resource.data.stars is number &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5 &&
        request.resource.data.eventoId is string;
      allow update, delete: if isAdmin();
    }

    // ── Trivias (lectura pública — participantes ven preguntas) ─────────────
    match /eventoTrivias/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Resultados de trivia (escritura pública validada) ────────────────────
    match /eventoTriviaResultados/{doc} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['eventoId', 'estacionId', 'puntos']) &&
        request.resource.data.eventoId is string &&
        request.resource.data.estacionId is string &&
        request.resource.data.puntos is number &&
        request.resource.data.puntos >= 0;
      allow update, delete: if isAdmin();
    }

    // ── Usuarios (cada quien lee/escribe el suyo; admins ven los de su cliente) ─
    match /eventoUsuarios/{userId} {
      // Leer el propio perfil: condición directa, sin llamar getUserRole()
      // para evitar recursión en el get() interno de los helpers.
      allow read: if isAuth() && request.auth.uid == userId;
      // Admins pueden leer perfiles de otros usuarios de su MISMO cliente;
      // superadmin ve todos.
      allow read: if isSuperAdmin() ||
        (isAdmin() && resource.data.clienteId == getUserClienteId());
      // Crear el propio perfil al aceptar una invitación
      // (no permite auto-asignarse rol superadmin)
      allow create: if isAuth() && request.auth.uid == userId &&
        request.resource.data.role != 'superadmin';
      // Actualizar el propio perfil, o un admin de su mismo cliente, o superadmin
      allow update: if isAuth() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isAdmin() && resource.data.clienteId == getUserClienteId())
      );
      allow delete: if isSuperAdmin();
    }

    // ── Invitaciones (colección real: "invitaciones") ───────────────────────
    // Se lee/actualiza durante el primer login (aceptar invitación), antes de
    // que exista el perfil en eventoUsuarios — por eso no puede depender de
    // isAdmin()/isStaff() para read/update, solo del email autenticado.
    match /invitaciones/{doc} {
      allow read, update: if isAuth() && resource.data.email == request.auth.token.email;
      allow create: if isSuperAdmin() ||
        (isAdmin() && request.resource.data.clienteId == getUserClienteId());
      allow delete: if isSuperAdmin();
    }

    // ── Empresas (acotadas por clienteId; superadmin ve todas) ──────────────
    match /eventoEmpresas/{doc} {
      allow read: if isSuperAdmin() ||
        (isAuth() && resource.data.clienteId == getUserClienteId());
      allow write: if isSuperAdmin() ||
        (isAdmin() && request.resource.data.clienteId == getUserClienteId());
    }

    // ── Clientes (colección real: "clientes") ────────────────────────────────
    // get() individual (branding público por slug/id) queda abierto;
    // list() completo (panel superadmin) solo para superadmin o consultas
    // acotadas a 1 resultado (búsqueda por slug con limit(1) en el código).
    match /clientes/{doc} {
      allow get: if true;
      allow list: if isSuperAdmin() || request.query.limit <= 1;
      allow write: if isSuperAdmin();
    }
  }
}
