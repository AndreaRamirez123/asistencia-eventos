rules_version = '2';
service cloud.firestore {
  match /databases/eventos-divergentes/documents {

    // ── Públicas (sin login) ────────────────────────────────────
    match /eventoAsistentes/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /eventoEstaciones/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /eventoEventos/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /eventoVisitas/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /eventoCalificaciones/{doc} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    match /eventoTrivias/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /eventoTriviaResultados/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // ── Solo autenticados ───────────────────────────────────────
    match /eventoUsuarios/{doc} {
      allow read, write: if request.auth != null;
    }
    match /eventoInvitaciones/{doc} {
      allow read, write: if request.auth != null;
    }
    match /eventoEmpresas/{doc} {
      allow read, write: if request.auth != null;
    }
    match /eventoClientes/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
